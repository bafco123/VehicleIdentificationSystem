<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="0" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.vehicleidentification.controller.BrowseRecordsController"
      style="-fx-background-color: #f5f7fa;">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 15; -fx-background-color: #2c3e50;">
        <Label text="📋 Browse Records" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="✖ Close" onAction="#closeWindow" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-cursor: hand;"/>
    </HBox>

    <!-- Filter Bar -->
    <HBox spacing="15" style="-fx-padding: 15; -fx-background-color: white;">
        <Label text="Show:" style="-fx-font-weight: bold;"/>
        <ComboBox fx:id="tableSelector" prefWidth="150" promptText="Select Table"/>
        <Separator orientation="VERTICAL"/>
        <Label text="Search:" style="-fx-font-weight: bold;"/>
        <TextField fx:id="searchField" promptText="Search records..." HBox.hgrow="ALWAYS"/>
        <Button text="🔍 Search" onAction="#searchRecords" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand;"/>
        <Button text="Clear" onAction="#clearSearch" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-cursor: hand;"/>
        <Button text="📊 Export CSV" onAction="#exportToCSV" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-cursor: hand;"/>
    </HBox>

    <!-- Table View -->
    <TableView fx:id="recordsTable" VBox.vgrow="ALWAYS" style="-fx-padding: 0 15 0 15;">
        <placeholder>
            <Label text="No records found. Select a table to view data." style="-fx-text-fill: #7f8c8d;"/>
        </placeholder>
    </TableView>

    <!-- Pagination Footer -->
    <HBox alignment="CENTER" spacing="20" style="-fx-padding: 15; -fx-background-color: #ecf0f1;">
        <Button text="⏮ First" onAction="#firstPage" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-cursor: hand;"/>
        <Button text="◀ Previous" onAction="#previousPage" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-cursor: hand;"/>

        <HBox alignment="CENTER" spacing="5">
            <Label text="Page"/>
            <TextField fx:id="pageNumberField" prefWidth="50" text="1" style="-fx-alignment: center;"/>
            <Label text="of"/>
            <Label fx:id="totalPagesLabel" text="1"/>
        </HBox>

        <Button text="Go" onAction="#goToPage" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-cursor: hand;"/>

        <Button text="Next ▶" onAction="#nextPage" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-cursor: hand;"/>
        <Button text="Last ⏭" onAction="#lastPage" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-cursor: hand;"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Label fx:id="recordInfoLabel" text="Showing 0-0 of 0 records" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
    </HBox>

    <!-- Status Bar -->
    <HBox style="-fx-padding: 5 15; -fx-background-color: #bdc3c7;">
        <Label fx:id="statusLabel" text="Ready" style="-fx-font-size: 11px;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="connectionStatus" text="✅ Connected" style="-fx-font-size: 11px; -fx-text-fill: green;"/>
    </HBox>
</VBox>