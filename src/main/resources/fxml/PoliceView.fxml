<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.vehicleidentification.controller.PoliceController">

    <Label text="Police Module" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <TabPane>
        <!-- Police Reports Tab -->
        <Tab text="Police Reports">
            <VBox spacing="10">
                <GridPane hgap="10" vgap="10">
                    <Label text="Vehicle ID:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="reportVehicleIdField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Report Date:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <DatePicker fx:id="reportDatePicker" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Report Type:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="reportTypeCombo" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Description:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <TextArea fx:id="reportDescriptionField" prefHeight="80" prefWidth="300"/>

                    <Label text="Location:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <TextField fx:id="reportLocationField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                    <Label text="Officer Name:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <TextField fx:id="officerNameField" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                    <HBox spacing="10" GridPane.rowIndex="6" GridPane.columnIndex="0" GridPane.columnSpan="2">
                        <Button text="Add Report" onAction="#addReport"/>
                        <Button text="Delete Report" onAction="#deleteReport"/>
                        <Button text="Clear" onAction="#clearReportForm"/>
                    </HBox>
                </GridPane>

                <Separator/>

                <TableView fx:id="reportTable" prefHeight="250">
                    <columns>
                        <TableColumn text="Report ID" fx:id="colReportId" prefWidth="60"/>
                        <TableColumn text="Vehicle ID" fx:id="colReportVehicleId" prefWidth="80"/>
                        <TableColumn text="Date" fx:id="colReportDate" prefWidth="100"/>
                        <TableColumn text="Type" fx:id="colReportType" prefWidth="100"/>
                        <TableColumn text="Description" fx:id="colReportDescription" prefWidth="200"/>
                        <TableColumn text="Location" fx:id="colReportLocation" prefWidth="150"/>
                        <TableColumn text="Officer" fx:id="colOfficerName" prefWidth="150"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>

        <!-- Violations Tab -->
        <Tab text="Violations">
            <VBox spacing="10">
                <GridPane hgap="10" vgap="10">
                    <Label text="Vehicle ID:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="violationVehicleIdField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Violation Date:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <DatePicker fx:id="violationDatePicker" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Violation Type:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="violationTypeCombo" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Location:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <TextField fx:id="violationLocationField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <Label text="Fine Amount:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <TextField fx:id="fineAmountField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                    <Label text="Status:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="violationStatusCombo" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                    <HBox spacing="10" GridPane.rowIndex="6" GridPane.columnIndex="0" GridPane.columnSpan="2">
                        <Button text="Add Violation" onAction="#addViolation"/>
                        <Button text="Update" onAction="#updateViolation"/>
                        <Button text="Mark Paid" onAction="#markAsPaid"/>
                        <Button text="Delete" onAction="#deleteViolation"/>
                        <Button text="Clear" onAction="#clearViolationForm"/>
                    </HBox>
                </GridPane>

                <Separator/>

                <TableView fx:id="violationTable" prefHeight="250">
                    <columns>
                        <TableColumn text="Violation ID" fx:id="colViolationId" prefWidth="60"/>
                        <TableColumn text="Vehicle ID" fx:id="colViolationVehicleId" prefWidth="80"/>
                        <TableColumn text="Date" fx:id="colViolationDate" prefWidth="100"/>
                        <TableColumn text="Type" fx:id="colViolationType" prefWidth="150"/>
                        <TableColumn text="Location" fx:id="colViolationLocation" prefWidth="150"/>
                        <TableColumn text="Fine" fx:id="colFineAmount" prefWidth="100"/>
                        <TableColumn text="Status" fx:id="colViolationStatus" prefWidth="80"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>
    </TabPane>

    <ProgressBar fx:id="progressBar" prefWidth="200" visible="false"/>
</VBox>