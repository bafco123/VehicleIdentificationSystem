<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="30" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.vehicleidentification.controller.WelcomeController"
      style="-fx-background-color: linear-gradient(to bottom, #2c3e50, #3498db);">

    <!-- Welcome Content -->
    <VBox alignment="CENTER" spacing="20">
        <Label text="🚗" style="-fx-font-size: 80px; -fx-text-fill: white;"/>

        <Label text="Vehicle Identification System"
               style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: white;"/>

        <Label text="A Comprehensive Vehicle Management Solution"
               style="-fx-font-size: 18px; -fx-text-fill: #ecf0f1;"/>

        <Separator prefWidth="400" style="-fx-background-color: #ecf0f1;"/>

        <Label text="Complete Vehicle Lifecycle Management"
               style="-fx-font-size: 14px; -fx-text-fill: #bdc3c7;"/>

        <HBox spacing="30" alignment="CENTER">
            <VBox alignment="CENTER" spacing="10">
                <Label text="🚗" style="-fx-font-size: 30px;"/>
                <Label text="Vehicle Registration" style="-fx-text-fill: white;"/>
            </VBox>
            <VBox alignment="CENTER" spacing="10">
                <Label text="👤" style="-fx-font-size: 30px;"/>
                <Label text="Customer Management" style="-fx-text-fill: white;"/>
            </VBox>
            <VBox alignment="CENTER" spacing="10">
                <Label text="🔧" style="-fx-font-size: 30px;"/>
                <Label text="Workshop Services" style="-fx-text-fill: white;"/>
            </VBox>
            <VBox alignment="CENTER" spacing="10">
                <Label text="📄" style="-fx-font-size: 30px;"/>
                <Label text="Insurance Tracking" style="-fx-text-fill: white;"/>
            </VBox>
            <VBox alignment="CENTER" spacing="10">
                <Label text="👮" style="-fx-font-size: 30px;"/>
                <Label text="Police Records" style="-fx-text-fill: white;"/>
            </VBox>
        </HBox>
    </VBox>

    <!-- Bottom Section -->
    <VBox alignment="CENTER" spacing="10">
        <Button fx:id="enterButton" text="Enter Application" onAction="#enterApplication"
                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 16px; -fx-padding: 10 30 10 30; -fx-background-radius: 5;"/>

        <Label text="Version 2.0 | © 2026" style="-fx-text-fill: #bdc3c7; -fx-font-size: 11px;"/>
    </VBox>

    <padding>
        <Insets top="50" right="50" bottom="50" left="50"/>
    </padding>
</VBox>