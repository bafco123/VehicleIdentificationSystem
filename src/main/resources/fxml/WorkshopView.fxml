<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.vehicleidentification.controller.WorkshopController">

    <Label text="Workshop Services" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <Label text="Module Loaded Successfully!" style="-fx-text-fill: green;"/>

    <Separator/>

    <Label text="Service Management" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Vehicle ID:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="vehicleIdField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Service Date:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <DatePicker fx:id="serviceDatePicker" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Service Type:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="serviceTypeField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Cost:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="costField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <HBox spacing="10" GridPane.rowIndex="4" GridPane.columnIndex="0" GridPane.columnSpan="2">
            <Button text="Add Service" onAction="#addService"/>
            <Button text="Clear" onAction="#clearForm"/>
        </HBox>
    </GridPane>

    <Separator/>

    <TableView fx:id="serviceTable" prefHeight="350">
        <columns>
            <TableColumn text="ID" fx:id="colServiceId" prefWidth="60"/>
            <TableColumn text="Vehicle ID" fx:id="colVehicleId" prefWidth="80"/>
            <TableColumn text="Date" fx:id="colServiceDate" prefWidth="100"/>
            <TableColumn text="Type" fx:id="colServiceType" prefWidth="150"/>
            <TableColumn text="Cost" fx:id="colCost" prefWidth="100"/>
        </columns>
    </TableView>

    <ProgressBar fx:id="progressBar" prefWidth="200" visible="false"/>
</VBox>