<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.vehicleidentification.controller.CustomerController">

    <Label text="Customer Management" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Full Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="250" promptText="John Doe"/>

        <Label text="Address:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextArea fx:id="addressField" GridPane.rowIndex="1" GridPane.columnIndex="1" prefHeight="60" prefWidth="250" promptText="123 Main Street, City, State"/>

        <Label text="Phone Number:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="phoneField" GridPane.rowIndex="2" GridPane.columnIndex="1" promptText="+1-555-123-4567"/>

        <Label text="Email Address:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="emailField" GridPane.rowIndex="3" GridPane.columnIndex="1" promptText="customer@example.com"/>

        <HBox spacing="10" GridPane.rowIndex="4" GridPane.columnIndex="0" GridPane.columnSpan="2">
            <Button text="Add Customer" onAction="#addCustomer"/>
            <Button text="Update" onAction="#updateCustomer"/>
            <Button text="Delete" onAction="#deleteCustomer"/>
            <Button text="Clear" onAction="#clearForm"/>
        </HBox>
    </GridPane>

    <Separator/>

    <TableView fx:id="customerTable" prefHeight="400">
        <columns>
            <TableColumn text="ID" fx:id="colId" prefWidth="60"/>
            <TableColumn text="Name" fx:id="colName" prefWidth="150"/>
            <TableColumn text="Address" fx:id="colAddress" prefWidth="200"/>
            <TableColumn text="Phone" fx:id="colPhone" prefWidth="120"/>
            <TableColumn text="Email" fx:id="colEmail" prefWidth="180"/>
        </columns>
    </TableView>

    <ProgressIndicator fx:id="progressIndicator" visible="false" prefWidth="30"/>
</VBox>